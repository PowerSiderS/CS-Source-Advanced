//-----------------------------------------------------------------------------
// video_theora.vpc
//
// Theora video sub-system for CS: Source Advanced
// Supports: Windows (x86/x64), Linux (x86/ARM/AArch64)
//
// Dependencies (must be built as static libs in $LIBCOMMON):
//   libtheora  — video decode (libogg + libtheora)
//   libogg     — Ogg bitstream container
//   libvorbis  — audio decode
//-----------------------------------------------------------------------------

$Macro SRCDIR ".."
$Macro OUTBINDIR "$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
    $Compiler
    {
        $AdditionalIncludeDirectories   "$BASE;$SRCDIR\thirdparty\libogg\include"
        $AdditionalIncludeDirectories   "$BASE;$SRCDIR\thirdparty\libtheora\include"
        $AdditionalIncludeDirectories   "$BASE;$SRCDIR\thirdparty\libvorbis\include"
        $AdditionalIncludeDirectories   "$BASE;$SRCDIR\dx9sdk\include" [$WIN32]
    }
    $Linker
    {
        $IgnoreImportLibrary            "Yes" [$WIN32]
        $SystemLibraries                "iconv" [$OSXALL]
        $SystemFrameworks               "Carbon" [$OSXALL]
        $AdditionalLibraryDirectories   "$BASE;$SRCDIR\dx9sdk\lib" [$WIN32]
    }
}

$Configuration "Debug"
{
    $General
    {
        $OutputDirectory        "Debug_Video_Theora"
        $IntermediateDirectory  "Debug_Video_Theora"
    }
}

$Configuration "Release"
{
    $General
    {
        $OutputDirectory        "Release_Video_Theora"
        $IntermediateDirectory  "Release_Video_Theora"
    }
}


$Project "video_theora"
{
    $Folder "Source Files"
    {
        $File "theora_video.cpp"
        $File "theora_material.cpp"
    }

    $Folder "Header Files"
    {
        $File "theora_common.h"
        $File "theora_video.h"
        $File "theora_material.h"
        $File "$SRCDIR\video\videosubsystem.h"
        $File "$SRCDIR\video\video_macros.h"
        $File "$SRCDIR\public\pixelwriter.h"
    }

    $Folder "Interface"
    {
        $File "$SRCDIR\public\video\ivideoservices.h"
    }

    $Folder "Link Libraries"
    {
        $Lib tier1
        $Lib tier2
        $Lib $LIBCOMMON/libtheora
        $Lib $LIBCOMMON/libogg
        $Lib $LIBCOMMON/libvorbis
    }
}
